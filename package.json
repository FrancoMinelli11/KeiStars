{
  "name": "keistars",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Pósters conmemorativos de mapa estelar generados en el navegador con d3-celestial.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.6",
    "@fontsource/cormorant-garamond": "^5.2.6",
    "@fontsource/courier-prime": "^5.2.6",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/merriweather": "^5.2.6",
    "@fontsource/playfair-display": "^5.2.6",
    "@fontsource/space-mono": "^5.2.6",
    "d3-celestial": "^0.7.35",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  }
}
